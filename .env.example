# Local development only. Export these variables before running Alembic or the seeder.
DATABASE_URL=postgresql+psycopg://claim:claim_local@localhost:5432/claims
TEST_DATABASE_URL=postgresql+psycopg://claim:claim_local@localhost:5432/claims_test

# Required for extraction; keep your actual API key out of source control.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=1000

# Gemini free-tier configuration
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=2048

# PDF ingestion limits and OCR defaults.
PDF_MAX_BYTES=26214400
PDF_MAX_PAGES=200
PDF_NATIVE_TIMEOUT_SECONDS=30
PDF_OCR_LANGUAGE=eng
PDF_OCR_DPI=200
PDF_OCR_TIMEOUT_SECONDS=60
PDF_OCR_MAX_PIXELS=25000000
